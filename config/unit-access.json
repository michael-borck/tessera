  "accessModes": {
    "time-based": {
      "description": "Uses existing time-based release system",
      "behavior": "Content unlocks based on consultant/auditor dates"
    },
    "scenario-based": {
      "description": "Uses only allowed/denied lists, ignores time release",
      "behavior": "Immediate access to allowed content, blocked access to denied"
    },
    "combined": {
      "description": "Uses both time release AND allowed/denied lists",
      "behavior": "Time release applies to allowed content, denied content always blocked"
    }
